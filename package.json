{
  "name": "at-file",
  "displayName": "At File",
  "description": "Complete workspace files and directories after typing @.",
  "version": "1.0.2",
  "publisher": "opensource-100",
  "icon": "public-icon-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/opensource-100/vscode-at-file-extension"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "atFile.refreshIndex",
        "title": "At File: Refresh Index"
      }
    ],
    "configuration": {
      "title": "At File",
      "properties": {
        "atFile.enabledExtensions": {
          "type": "string",
          "default": "md, txt",
          "description": "File extensions where @ file completion is enabled, comma-separated. Do not include dots."
        },
        "atFile.exclude": {
          "type": "string",
          "default": "node_modules, target, .git, dist, build, .next, .idea, .vscode",
          "description": "Directory names or glob patterns excluded from file completion, comma-separated."
        },
        "atFile.maxResults": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 5000,
          "description": "Maximum number of file and directory completion items."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/suite/core.test.js",
    "package": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.8",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.4.5"
  }
}
